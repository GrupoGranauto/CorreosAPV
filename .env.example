# GMAIL API (remitente de las invitaciones)
# Se llenan solos con: python configurar_railway.py todo --client <client_secret.json>
GMAIL_SENDER=tu_correo@grupogranauto.mx
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# GOOGLE SHEETS (cuenta de servicio con acceso de edición a la hoja)
# En Railway: GOOGLE_SERVICE_ACCOUNT_JSON con el contenido del JSON.
# En local: GOOGLE_SERVICE_ACCOUNT_FILE con la ruta del archivo.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
SPREADSHEET_ID=1o_gr48pIWG5hrVf51Q5R8RPTa4eJL6f6a0Whk-2LGN0
SHEET_NAME=Calendar
WORKER_INTERVAL_SECONDS=15
WORKER_ENABLED=true

# CONFIGURACIÓN DE TIEMPO (respaldo; el worker usa la zona horaria de la hoja)
DEFAULT_TIMEZONE=America/Hermosillo

# AUTENTICACIÓN DEL ENDPOINT /webhook
API_SECRET_KEY=tu_api_key_secreta_aqui
